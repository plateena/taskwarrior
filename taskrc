data.location=$HOME/Documents/task
news.version=3.4.1

hooks.location=~/.config/task/hooks

include /home/mzd/.config/task/themes/nord.theme

report.next.columns=id,status.short,scheduled.remaining,start.age,description.count,due.remaining,tags,urgency
report.next.labels=ID,St,Sch,St,Description,Due,Tags,urgency
report.next.filter=status:pending -WAITING -sub -hide -give_away
report.next.sort=urgency-

report.todo.description=Tasks with project todo
report.todo.filter=status.not:completed and status.not:deleted and status.not:waiting and project:todo -give_away
report.todo.columns=id,status.short,scheduled.remaining,start.age,description.count,due.remaining,tags,urgency
report.todo.labels=ID,St,Sch,St,Description,Due,Tags,urgency
report.todo.sort=due+,urgency-,priority+

report.jira.description=Tasks with Jira Key
report.jira.columns=id,project,priority,due,jira_key,description,jira_stat,urgency
report.jira.labels=ID,Project,Priority,Due,Jira Key,Description,Jira Status,Urg
report.jira.sort=due+,urgency-,priority+
report.jira.filter=jira_key.any: -WAITING -COMPLETED -DELETED -hide -give_away

report.jira-todo.description=Tasks with Jira Key
report.jira-todo.columns=id,project,priority,due,jira_key,description,jira_stat,urgency
report.jira-todo.labels=ID,Project,Priority,Due,Jira Key,Description,Jira Status,Urg
report.jira-todo.sort=due+,urgency-,priority+
report.jira-todo.filter=status.not:completed and status.not:deleted and jira_key.any: and (jira_stat:ToDo or jira_stat:InProgress) -hide -give_away

report.active.columns=id,start.age,description
report.active.context=1
report.active.description=Active tasks
report.active.filter=status:pending -WAITING +ACTIVE
report.active.labels=ID,Active,Description
report.active.sort=project+,start+

uda.jira_key.type=string
uda.jira_key.label=Jira Key
uda.link.type=string
uda.link.label=Links
uda.components.type=string
uda.components.label=Components
uda.jira_stat.type=string
uda.jira_stat.label=Jira Status

uda.priority.values=H,M,,L
urgency.uda.priority.H.coefficient=6.0
urgency.uda.priority.M.coefficient=3.9
urgency.uda.priority..coefficient=1.8
urgency.uda.priority.L.coefficient=0

urgency.active.coefficient=20
urgency.age.coefficient=0
urgency.annotations.coefficient=0
urgency.due.coefficient=20.0
urgency.blocking.coefficient=4.0
urgency.blocked.coefficient=0.1
urgency.scheduled.coefficient=0
urgency.user.tag.today.coefficient=10.0
urgency.user.tag.Deployed.coefficient=-6
urgency.user.tag.sprint.coefficient=3

color.tag.sprint=bold
color.uda.jira_stat.CodeReview=black
color.uda.jira_stat.InProgress=magenta

verbose=affected,blank,context,edit,header,footnote,label,new-id,new-uuid,news,project,special,sync,recur,filter,unwait

regex=on
search.case.sensitive=no

context.inherit=no
context.jira.read=\/^JIRA\/
context.meet=project:work.meeting
context.sprint.read=+sprint
journal.info=off

confirmation=on
recurrence.confirmation=on

# Alias
alias.jopen=execute /home/mzd/bin/ts-jira open
alias.jcopy=execute /home/mzd/bin/ts-jira copy
alias.jsync=execute sh -c "/home/mzd/bin/jira-taskwarrior --no-dry-run"
alias.jsync-dry=execute sh -c "/home/mzd/bin/jira-taskwarrior --dry-run"
alias.link=execute /home/mzd/bin/ts-open-link
alias.topen=execute /home/mzd/bin/tasktodo

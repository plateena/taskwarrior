#!/usr/bin/env python3

import json
import sys
from datetime import date, datetime


def is_scheduled_today(task):
    scheduled = task.get("scheduled")
    if not scheduled:
        return False
    scheduled_date = datetime.strptime(scheduled[:8], "%Y%m%d").date()
    return scheduled_date <= date.today()


def main():
    old = json.loads(sys.stdin.readline())
    new = json.loads(sys.stdin.readline())

    tags = set(new.get("tags", []))

    if is_scheduled_today(new):
        tags.add("today")
    else:
        tags.discard("today")

    if tags:
        new["tags"] = sorted(tags)
    elif "tags" in new:
        del new["tags"]

    print(json.dumps(new))


if __name__ == "__main__":
    main()
